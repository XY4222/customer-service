[project]
sub_id = "b5f7c57e"
name = "projects"
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "./scripts/coze-preview-build.sh"]
run = ["bash", "./scripts/coze-preview-run.sh"]
validate = ["bash", "./scripts/validate.sh"]

[deploy]
build = ["bash", "./scripts/build.sh"]
run = ["bash", "./scripts/start.sh"]

[deploy.profile]
kind = "service"
flavor = "web"
